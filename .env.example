# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
#
# Obten apiKey y databaseURL con:
#   firebase apps:sdkconfig WEB
#
# .env esta ignorado por git a proposito: no lo commitees nunca.

# Clave publica de la API web del proyecto Firebase.
IBASHO_API_KEY=

# URL de la Realtime Database, sin barra final.
IBASHO_DATABASE_URL=

# Dominio interno con el que se construye el email sintetico de cada cuenta.
# El usuario nunca ve esta direccion.
IBASHO_EMAIL_DOMAIN=ibasho.top

# Emulador de Firebase. Solo para desarrollo y para los tests de reglas.
IBASHO_USE_EMULATOR=false
IBASHO_EMULATOR_HOST=127.0.0.1
IBASHO_EMULATOR_DB_PORT=9000
IBASHO_EMULATOR_AUTH_PORT=9099
IBASHO_PROJECT_ID=
