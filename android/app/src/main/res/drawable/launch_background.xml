<?xml version="1.0" encoding="utf-8"?>
<!-- Lo que se ve mientras arranca el proceso: el metal del bisel y la marca en
     el centro, para que el salto al splash de la app no se note. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bezel" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_mark" />
    </item>
</layer-list>
