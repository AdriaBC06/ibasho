<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lo que pinta el sistema desde que se toca el icono hasta que Flutter
         dibuja su primer fotograma. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- El entorno llega hasta el borde y se encarga el mismo de respetar
             muescas y esquinas (ver lib/ui/canvas.dart). -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- El fondo de la ventana ya con Flutter dentro. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bezel</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
