{"id":"kasa_es","lang":"es","lines":[{"start":16.0,"end":24.0,"bars":[{"text":"Día de lluvia","notes":[[16.0,0.5],[16.5,0.5],[17.0,1.0],[18.0,1.0],[19.0,1.0]]},{"text":"y un paraguas","notes":[[20.0,0.5],[20.5,0.5],[21.0,1.0],[22.0,1.0],[23.0,1.0]]}]},{"start":24.0,"end":32.0,"bars":[{"text":"se moja mi hombro","notes":[[24.0,0.5],[24.5,0.5],[25.0,1.0],[26.0,0.5],[26.5,0.5],[27.0,1.0]]},{"text":"tú no me dices","notes":[[28.0,1.0],[29.0,0.5],[29.5,0.5],[30.0,1.0],[31.0,1.0]]}]},{"start":32.0,"end":40.0,"bars":[{"text":"Tu lado cerca","notes":[[32.0,0.5],[32.5,0.5],[33.0,1.0],[34.0,1.0],[35.0,1.0]]},{"text":"nuestros pasos van","notes":[[36.0,0.5],[36.5,0.5],[37.0,1.0],[38.0,1.0],[39.0,1.0]]}]},{"start":40.0,"end":48.0,"bars":[{"text":"con el mismo ritmo","notes":[[40.0,0.5],[40.5,0.5],[41.0,1.0],[42.0,0.5],[42.5,0.5],[43.0,1.0]]},{"text":"vamos caminando","notes":[[44.0,0.5],[44.5,0.5],[45.0,0.5],[45.5,0.5],[46.0,1.0],[47.0,1.0]]}]},{"start":48.0,"end":56.0,"bars":[{"text":"La lluvia canta hoy","notes":[[48.0,0.5],[48.5,0.5],[49.0,1.0],[50.0,0.5],[50.5,0.5],[51.0,1.0]]},{"text":"una canción suave","notes":[[52.0,0.5],[52.5,0.5],[53.0,1.0],[54.0,0.5],[54.5,0.5],[55.0,1.0]]}]},{"start":56.0,"end":64.0,"bars":[{"text":"sólo para los dos","notes":[[56.0,0.5],[56.5,0.5],[57.0,1.0],[58.0,0.5],[58.5,0.5],[59.0,1.0]]},{"text":"tú y yo aquí","notes":[[60.0,1.0],[61.0,0.5],[61.5,0.5],[62.0,1.0],[63.0,1.0]]}]},{"start":64.0,"end":72.0,"bars":[{"text":"no pares todavía","notes":[[64.0,0.5],[64.5,0.5],[65.0,1.0],[66.0,0.5],[66.5,0.5],[67.0,1.0]]},{"text":"quédate un poco","notes":[[68.0,0.5],[68.5,0.5],[69.0,1.0],[70.0,0.5],[70.5,0.5],[71.0,1.0]]}]},{"start":72.0,"end":80.0,"bars":[{"text":"quiero estar así","notes":[[72.0,0.5],[72.5,0.5],[73.0,1.0],[74.0,0.5],[74.5,0.5],[75.0,1.0]]},{"text":"no pares","notes":[[76.0,1.0],[77.0,1.0],[78.0,2.0]]}]},{"start":96.0,"end":104.0,"bars":[{"text":"Es mi paraguas","notes":[[96.0,0.5],[96.5,0.5],[97.0,1.0],[98.0,1.0],[99.0,1.0]]},{"text":"es pequeño, sí","notes":[[100.0,0.5],[100.5,0.5],[101.0,1.0],[102.0,1.0],[103.0,1.0]]}]},{"start":104.0,"end":112.0,"bars":[{"text":"si estás me basta","notes":[[104.0,0.5],[104.5,0.5],[105.0,1.0],[106.0,0.5],[106.5,0.5],[107.0,1.0]]},{"text":"ya no quiero más","notes":[[108.0,1.0],[109.0,0.5],[109.5,0.5],[110.0,1.0],[111.0,1.0]]}]},{"start":112.0,"end":120.0,"bars":[{"text":"La lluvia canta hoy","notes":[[112.0,0.5],[112.5,0.5],[113.0,1.0],[114.0,0.5],[114.5,0.5],[115.0,1.0]]},{"text":"una canción suave","notes":[[116.0,0.5],[116.5,0.5],[117.0,1.0],[118.0,0.5],[118.5,0.5],[119.0,1.0]]}]},{"start":120.0,"end":128.0,"bars":[{"text":"sólo para los dos","notes":[[120.0,0.5],[120.5,0.5],[121.0,1.0],[122.0,0.5],[122.5,0.5],[123.0,1.0]]},{"text":"tú y yo aquí","notes":[[124.0,1.0],[125.0,0.5],[125.5,0.5],[126.0,1.0],[127.0,1.0]]}]},{"start":128.0,"end":136.0,"bars":[{"text":"no pares todavía","notes":[[128.0,0.5],[128.5,0.5],[129.0,1.0],[130.0,0.5],[130.5,0.5],[131.0,1.0]]},{"text":"quédate un poco","notes":[[132.0,0.5],[132.5,0.5],[133.0,1.0],[134.0,0.5],[134.5,0.5],[135.0,1.0]]}]},{"start":136.0,"end":144.0,"bars":[{"text":"quiero estar así","notes":[[136.0,0.5],[136.5,0.5],[137.0,1.0],[138.0,0.5],[138.5,0.5],[139.0,1.0]]},{"text":"no pares","notes":[[140.0,1.0],[141.0,1.0],[142.0,2.0]]}]},{"start":144.0,"end":152.0,"bars":[{"text":"Tu mano fría","notes":[[144.0,1.0],[145.0,1.0],[146.0,1.0],[147.0,1.0]]},{"text":"me da calor","notes":[[148.0,1.0],[149.0,1.0],[150.0,1.0],[151.0,1.0]]}]},{"start":152.0,"end":160.0,"bars":[{"text":"queda en mí","notes":[[152.0,1.0],[153.0,1.0],[154.0,1.0],[155.0,1.0]]},{"text":"por siempre","notes":[[156.0,1.0],[157.0,1.0],[158.0,2.0]]}]},{"start":160.0,"end":168.0,"bars":[{"text":"La lluvia canta hoy","notes":[[160.0,0.5],[160.5,0.5],[161.0,1.0],[162.0,0.5],[162.5,0.5],[163.0,1.0]]},{"text":"una canción suave","notes":[[164.0,0.5],[164.5,0.5],[165.0,1.0],[166.0,0.5],[166.5,0.5],[167.0,1.0]]}]},{"start":168.0,"end":176.0,"bars":[{"text":"