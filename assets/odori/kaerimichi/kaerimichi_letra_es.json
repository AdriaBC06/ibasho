{"id":"kaerimichi_es","lang":"es","lines":[{"start":16.0,"end":24.0,"bars":[{"text":"El sol se apaga","notes":[[16.0,0.5],[16.5,0.5],[17.0,0.5],[17.5,0.5],[18.0,1],[19.0,1]]},{"text":"pedaleo por la calle","notes":[[20.0,0.5],[20.5,0.5],[21.0,0.5],[21.5,0.5],[22.0,0.5],[22.5,0.5],[23.0,1]]}]},{"start":24.0,"end":32.0,"bars":[{"text":"sigo tu espalda","notes":[[24.0,0.5],[24.5,0.5],[25.0,0.5],[25.5,0.5],[26.0,1],[27.0,1]]},{"text":"no quiero parar","notes":[[28.0,1.0],[29.0,0.5],[29.5,0.5],[30.0,1.0],[31.0,1.0]]}]},{"start":32.0,"end":40.0,"bars":[{"text":"La mochila baila","notes":[[32.0,0.5],[32.5,0.5],[33.0,0.5],[33.5,0.5],[34.0,1],[35.0,1]]},{"text":"cuentos que no son verdad","notes":[[36.0,0.5],[36.5,0.5],[37.0,0.5],[37.5,0.5],[38.0,0.5],[38.5,0.5],[39.0,1]]}]},{"start":40.0,"end":48.0,"bars":[{"text":"caemos de risa","notes":[[40.0,0.5],[40.5,0.5],[41.0,0.5],[41.5,0.5],[42.0,1],[43.0,1]]},{"text":"ya está cerca","notes":[[44.0,0.5],[44.5,0.5],[45.0,1],[46.0,1],[47.0,1]]}]},{"start":48.0,"end":56.0,"bars":[{"text":"Mañana nos vemos ya","notes":[[48.0,0.5],[48.5,0.5],[49.0,0.5],[49.5,0.5],[50.0,0.5],[50.5,0.5],[51.0,1]]},{"text":"te espero aquí","notes":[[52.0,0.5],[52.5,0.5],[53.0,0.5],[53.5,0.5],[54.0,1],[55.0,1]]}]},{"start":56.0,"end":64.0,"bars":[{"text":"es una promesa ya","notes":[[56.0,0.5],[56.5,0.5],[57.0,0.5],[57.5,0.5],[58.0,0.5],[58.5,0.5],[59.0,1]]},{"text":"de meñique ya","notes":[[60.0,0.5],[60.5,0.5],[61.0,1],[62.0,1],[63.0,1]]}]},{"start":64.0,"end":72.0,"bars":[{"text":"yo voy hasta el final","notes":[[64.0,0.5],[64.5,0.5],[65.0,0.5],[65.5,0.5],[66.0,0.5],[66.5,0.5],[67.0,1]]},{"text":"tú y yo sin miedo","notes":[[68.0,0.5],[68.5,0.5],[69.0,0.5],[69.5,0.5],[70.0,1],[71.0,1]]}]},{"start":72.0,"end":80.0,"bars":[{"text":"bajo el cielo de sol","notes":[[72.0,0.5],[72.5,0.5],[73.0,0.5],[73.5,0.5],[74.0,0.5],[74.5,0.5],[75.0,1]]},{"text":"a reír","notes":[[76.0,1.0],[77.0,1.0],[78.0,2.0]]}]},{"start":96.0,"end":104.0,"bars":[{"text":"La cuesta que 